<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0"><header><vendor>kotoba-lang/dynamics</vendor><product version="1.0">Kotoba network-effect and entry-barrier scenarios</product><name>Kotoba stack network scenarios</name></header><model name="Kotoba_Base_Network"><sim_specs method="rk4" time_units="years"><start>0.0</start><stop>10.0</stop><dt>0.05</dt></sim_specs><variables><aux name="Kotoba_Complement_Index"><eqn>MIN(1, (Total_Providers / Provider_Scale + Total_Components / Component_Scale + Verified_Receipts / Receipt_Scale) / 3)</eqn></aux><aux name="Developer_Adoption_From_Network"><eqn>MAX(0, Developer_Adoption - External_Developer_Rate * (Developer_Market - Independent_Developers) / Developer_Market)</eqn></aux><aux name="Complement_Value_Weight"><eqn>0.5</eqn></aux><aux name="Total_Components"><eqn>Owned_Reusable_Components + Independent_Components</eqn></aux><aux name="Entrant_Catchup_Cost"><eqn>Fixed_Technical_Cost + Entrant_Remaining_Units * Entrant_Cost_Per_Unit</eqn></aux><aux name="Developer_Market"><eqn>10000.0</eqn></aux><stock name="Active_Organizations"><eqn>5.0</eqn><non_negative/><inflow>Organization_Adoption</inflow></stock><aux name="Provider_Scale"><eqn>100.0</eqn></aux><aux name="Kotoba_Ecosystem_Value_Multiplier"><eqn>1 + Complement_Value_Weight * Kotoba_Complement_Index</eqn></aux><aux name="New_Entrant_Catchup_Cost"><eqn>Fixed_Technical_Cost + Barrier_Asset_Units * Entrant_Cost_Per_Unit</eqn></aux><aux name="Entrant_Replication_Throughput"><eqn>25.0</eqn></aux><aux name="External_Node_Rate"><eqn>0.5</eqn></aux><stock name="Independent_Providers"><eqn>0.0</eqn><non_negative/><inflow>Provider_Creation</inflow></stock><aux name="Component_Barrier_Weight"><eqn>0.1</eqn></aux><flow name="Entrant_Asset_Creation"><eqn>MIN(Entrant_Replication_Throughput, Entrant_Remaining_Units)</eqn></flow><aux name="Node_Scale"><eqn>100.0</eqn></aux><flow name="Node_Onboarding"><eqn>MAX(0, (External_Node_Rate + Node_Demand_Coefficient * Active_Organizations) * (Node_Market - Independent_Compute_Nodes) / Node_Market)</eqn></flow><aux name="Organization_Network_Adoption_Share"><eqn>Organization_Adoption_From_Network / MAX(Organization_Adoption, 0.000001)</eqn></aux><aux name="Entrant_Catchup_Years"><eqn>Entrant_Remaining_Units / Entrant_Replication_Throughput</eqn></aux><aux name="Node_Barrier_Weight"><eqn>3.0</eqn></aux><flow name="Developer_Adoption"><eqn>MAX(0, (External_Developer_Rate + Developer_Network_Coefficient * Independent_Developers * Kotoba_Complement_Index) * (Developer_Market - Independent_Developers) / Developer_Market)</eqn></flow><aux name="Organization_Barrier_Weight"><eqn>5.0</eqn></aux><aux name="Owned_Reusable_Components"><eqn>465.0</eqn></aux><aux name="Technical_Base_Units"><eqn>50.0</eqn></aux><aux name="Stack_Network_Coefficient"><eqn>0.03</eqn></aux><aux name="Node_Market"><eqn>1000.0</eqn></aux><aux name="New_Entrant_Catchup_Years"><eqn>Barrier_Asset_Units / Entrant_Replication_Throughput</eqn></aux><aux name="External_Developer_Rate"><eqn>5.0</eqn></aux><aux name="External_Organization_Rate"><eqn>1.0</eqn></aux><flow name="Component_Creation"><eqn>Component_Productivity * Independent_Developers</eqn></flow><aux name="Receipts_Per_Organization"><eqn>52.0</eqn></aux><stock name="Independent_Components"><eqn>0.0</eqn><non_negative/><inflow>Component_Creation</inflow></stock><aux name="Kotoba_Ecosystem_Value"><eqn>Independent_Developers * (1 + Complement_Value_Weight * Kotoba_Complement_Index)</eqn></aux><aux name="Receipt_Barrier_Weight"><eqn>0.001</eqn></aux><aux name="Entrant_Remaining_Units"><eqn>MAX(0, Barrier_Asset_Units - Entrant_Equivalent_Assets)</eqn></aux><aux name="Component_Scale"><eqn>1000.0</eqn></aux><aux name="Barrier_Asset_Units"><eqn>Technical_Base_Units + Provider_Barrier_Weight * Total_Providers + Component_Barrier_Weight * Total_Components + Receipt_Barrier_Weight * Verified_Receipts + Organization_Barrier_Weight * Active_Organizations + Node_Barrier_Weight * Total_Compute_Nodes</eqn></aux><aux name="Node_Demand_Coefficient"><eqn>0.05</eqn></aux><stock name="Independent_Compute_Nodes"><eqn>0.0</eqn><non_negative/><inflow>Node_Onboarding</inflow></stock><aux name="Total_Compute_Nodes"><eqn>Operator_Compute_Nodes + Independent_Compute_Nodes</eqn></aux><aux name="Stack_Complement_Index"><eqn>MIN(1, (Kotoba_Complement_Index + Total_Compute_Nodes / Node_Scale) / 2)</eqn></aux><aux name="Kotoba_Independent_Network_Value_Multiplier"><eqn>1 + Complement_Value_Weight * Independent_Network_Complement_Index</eqn></aux><aux name="Organization_Market"><eqn>1000.0</eqn></aux><stock name="Verified_Receipts"><eqn>0.0</eqn><non_negative/><inflow>Receipt_Creation</inflow></stock><aux name="Entry_Barrier_Index"><eqn>Barrier_Asset_Units / MAX(Technical_Base_Units, 0.000001)</eqn></aux><stock name="Independent_Developers"><eqn>0.0</eqn><non_negative/><inflow>Developer_Adoption</inflow></stock><aux name="Provider_Barrier_Weight"><eqn>1.0</eqn></aux><aux name="Entrant_Cost_Per_Unit"><eqn>100000.0</eqn></aux><flow name="Receipt_Creation"><eqn>Receipts_Per_Organization * Active_Organizations + Receipts_Per_Node * Independent_Compute_Nodes</eqn></flow><aux name="Operator_Compute_Nodes"><eqn>10.0</eqn></aux><aux name="Fixed_Technical_Cost"><eqn>3000000.0</eqn></aux><aux name="Independent_Network_Complement_Index"><eqn>MIN(1, (Independent_Providers / Provider_Scale + Independent_Components / Component_Scale + Verified_Receipts / Receipt_Scale) / 3)</eqn></aux><aux name="Component_Productivity"><eqn>0.25</eqn></aux><aux name="Total_Providers"><eqn>Owned_Capability_Providers + Independent_Providers</eqn></aux><aux name="Developer_Network_Adoption_Share"><eqn>Developer_Adoption_From_Network / MAX(Developer_Adoption, 0.000001)</eqn></aux><aux name="Owned_Capability_Providers"><eqn>57.0</eqn></aux><flow name="Provider_Creation"><eqn>Provider_Productivity * Independent_Developers</eqn></flow><aux name="Developer_Network_Coefficient"><eqn>0.05</eqn></aux><aux name="Provider_Productivity"><eqn>0.1</eqn></aux><stock name="Entrant_Equivalent_Assets"><eqn>0</eqn><non_negative/><inflow>Entrant_Asset_Creation</inflow></stock><aux name="Receipts_Per_Node"><eqn>500.0</eqn></aux><aux name="Organization_Adoption_From_Network"><eqn>MAX(0, Organization_Adoption - External_Organization_Rate * (Organization_Market - Active_Organizations) / Organization_Market)</eqn></aux><aux name="Receipt_Scale"><eqn>10000.0</eqn></aux><flow name="Organization_Adoption"><eqn>MAX(0, (External_Organization_Rate + Stack_Network_Coefficient * Active_Organizations * Stack_Complement_Index) * (Organization_Market - Active_Organizations) / Organization_Market)</eqn></flow></variables></model><model name="Kotoba_Base_Network_No_Network_Counterfactual"><sim_specs method="rk4" time_units="years"><start>0.0</start><stop>10.0</stop><dt>0.05</dt></sim_specs><variables><aux name="Kotoba_Complement_Index"><eqn>MIN(1, (Total_Providers / Provider_Scale + Total_Components / Component_Scale + Verified_Receipts / Receipt_Scale) / 3)</eqn></aux><aux name="Developer_Adoption_From_Network"><eqn>MAX(0, Developer_Adoption - External_Developer_Rate * (Developer_Market - Independent_Developers) / Developer_Market)</eqn></aux><aux name="Complement_Value_Weight"><eqn>0.5</eqn></aux><aux name="Total_Components"><eqn>Owned_Reusable_Components + Independent_Components</eqn></aux><aux name="Entrant_Catchup_Cost"><eqn>Fixed_Technical_Cost + Entrant_Remaining_Units * Entrant_Cost_Per_Unit</eqn></aux><aux name="Developer_Market"><eqn>10000.0</eqn></aux><stock name="Active_Organizations"><eqn>5.0</eqn><non_negative/><inflow>Organization_Adoption</inflow></stock><aux name="Provider_Scale"><eqn>100.0</eqn></aux><aux name="Kotoba_Ecosystem_Value_Multiplier"><eqn>1 + Complement_Value_Weight * Kotoba_Complement_Index</eqn></aux><aux name="New_Entrant_Catchup_Cost"><eqn>Fixed_Technical_Cost + Barrier_Asset_Units * Entrant_Cost_Per_Unit</eqn></aux><aux name="Entrant_Replication_Thro